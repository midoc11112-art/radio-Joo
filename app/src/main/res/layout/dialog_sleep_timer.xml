<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏱️ مؤقت النوم"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="عند انتهاء الوقت يتوقف البث ويُغلق التطبيق بالكامل"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="الساعات"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etSleepHours"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center"
        android:hint="0"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="2"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="الدقائق"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etSleepMinutes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center"
        android:hint="30"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="3"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvSleepRemaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#F59E0B"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
