<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fitsSystemWindows="true">

    <!-- الهيدر (لم يتغير) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">
        <!-- ... محتوى الهيدر كما هو ... -->
        
        <!-- (ضع باقي محتوى الهيدر هنا كما هو في الكود الأصلي) -->
    </LinearLayout>

    <!-- ✅ رسالة نجاح التحديث (جديد) -->
    <TextView
        android:id="@+id/tvUpdateSuccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_success_message"
        android:elevation="8dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:text="✅ تم تحديث المحطات بنجاح"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:alpha="0" />

    <!-- قائمة المحطات (لم تتغير) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/miniPlayerContainer"
        android:layout_below="@+id/headerLayout">
        <!-- ... محتوى القائمة كما هو ... -->
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- المشغل السفلي (لم يتغير) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/miniPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="16dp"
        app:strokeColor="#D4AF37"
        app:strokeWidth="2dp"
        app:cardElevation="8dp">
        <!-- ... محتوى المشغل كما هو ... -->
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
